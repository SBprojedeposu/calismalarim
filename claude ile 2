        <li><a href="#">İletişim</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Yardım</h4>
      <ul>
        <li><a href="#">SSS</a></li>
        <li><a href="#">Kargo & İade</a></li>
        <li><a href="#">Beden Rehberi</a></li>
        <li><a href="#">Mağazalarımız</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Sosyal</h4>
      <ul>
        <li><a href="#">Instagram</a></li>
        <li><a href="#">TikTok</a></li>
        <li><a href="#">Pinterest</a></li>
