    </a>
  </div>
  <div class="hero-image">
    <div class="hero-image-inner">👗</div>
  <div class="hero-badge">
      <strong>%40'a</strong>
      varan indirim
    </div>
  </div>
</section>

<!-- MARQUEE STRIP -->
<div class="strip">
  <div class="strip-inner">
    ÜCRETSİZ KARGO <span>★</span> 300₺ VE ÜZERİ <span>★</span> KOLAY İADE <span>★</span> 30 GÜN GARANTI <span>★</span> YENİ SEZON ÜRÜNLERİ <span>★</span> ÜCRETSİZ KARGO <span>★</span> 300₺ VE ÜZERİ <span>★</span> KOLAY İADE <span>★</span> 30 GÜN GARANTI <span>★</span> YENİ SEZON ÜRÜNLERİ <span>★</span>
  </div>
</div>

<!-- PRODUCTS -->
<div id="products">
  <div class="section-header">
    <h2 class="section-title">Öne Çıkan Ürünler</h2>
