    <span>© 2025 MODA. Tüm hakları saklıdır.</span>
    <span>Güvenli Ödeme • SSL Şifreli</span>
  </div>
</footer>

<script>
// ── DATA ──
const products = [
  { id:1, brand:'MODA Basics', name:'Oversize Keten Gömlek', price:649, oldPrice:899, emoji:'👔', tag:'Yeni', category:'kadin', rating:4.8, ratingCount:124 },
  { id:2, brand:'Urban Street', name:'Slim Fit Chino Pantolon', price:799, oldPrice:1099, emoji:'👖', tag:'İndirim', category:'erkek', rating:4.6, ratingCount:89 },
  { id:3, brand:'MODA Luxe', name:'Triko Kazak', price:1249, oldPrice:null, emoji:'🧶', tag:'Yeni', category:'kadin', rating:4.9, ratingCount:203 },
  { id:4, brand:'AccessoryLab', name:'Deri Kemer', price:449, oldPrice:599, emoji:'👜', tag:'İndirim', category:'aksesuar', rating:4.7, ratingCount:67 },
  { id:5, brand:'Urban Street', name:'Relaxed Fit Jean', price:899, oldPrice:1199, emoji:'🩲', tag:null, category:'erkek', rating:4.5, ratingCount:156 },
  { id:6, brand:'MODA Basics', name:'Crop Top Bluz', price:399, oldPrice:null, emoji:'👕', tag:'Yeni', category:'kadin yeni', rating:4.8, ratingCount:312 },
  { id:7, brand:'AccessoryLab', name:'Minimalist Kolye', price:349, oldPrice:499, emoji:'📿', tag:'İndirim', category:'aksesuar', rating:4.6, ratingCount:44 },
  { id:8, brand:'MODA Luxe', name:'Blazer Ceket', price:1899, oldPrice:2499, emoji:'🥼', tag:'Trend', category:'kadin erkek', rating:4.9, ratingCount:87 },
];

let cart = {};
let liked = {};
let activeFilter = 'all';

// ── RENDER PRODUCTS ──
function renderProducts(filter) {
  const grid = document.getElementById('productGrid');
  const filtered = filter === 'all' ? products : products.filter(p => p.category.includes(filter));
  grid.innerHTML = filtered.map((p, i) => `
    <div class="product-card" style="animation-delay:${i * 0.07}s" data-id="${p.id}">
      <div class="product-image">
        <div class="product-image-bg" style="background:${getBg(i)}">${p.emoji}</div>
        ${p.tag ? `<span class="product-tag">${p.tag}</span>` : ''}
        <button class="wishlist-btn ${liked[p.id] ? 'liked' : ''}" onclick="toggleLike(event, ${p.id})">
          <svg width="16" height="16" fill="${liked[p.id] ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </button>
      </div>
      <div class="product-info">
        <p class="product-brand">${p.brand}</p>
        <p class="product-name">${p.name}</p>
        <div class="rating">
          <span class="stars">${'★'.repeat(Math.floor(p.rating))}${'☆'.repeat(5-Math.floor(p.rating))}</span>
          <span class="rating-count">(${p.ratingCount})</span>
        </div>
        <div class="product-footer">
          <div class="product-price">
            ${p.oldPrice ? `<span class="old-price">₺${p.oldPrice.toLocaleString('tr-TR')}</span>` : ''}
            ₺${p.price.toLocaleString('tr-TR')}
          </div>
          <button class="add-to-cart ${cart[p.id] ? 'added' : ''}" id="btn-${p.id}" onclick="addToCart(event, ${p.id})">
            ${cart[p.id] ? '✓ Eklendi' : '+ Ekle'}
          </button>
        </div>
      </div>
    </div>
  `).join('');
}

function getBg(i) {
  const bgs = ['#e8ddd4','#d4dde8','#dde8d4','#e8d4dd','#d4e8e4','#e8e4d4','#d8d4e8','#e4e8d4'];
  return bgs[i % bgs.length];
}

// ── FILTER ──
function filterProducts(btn, filter) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  activeFilter = filter;
  renderProducts(filter);
}

// ── CART ──
function addToCart(e, id) {
  e.stopPropagation();
  const p = products.find(x => x.id === id);
  if (!cart[id]) cart[id] = { ...p, qty: 0 };
  cart[id].qty++;
  updateCartCount();
  renderCartItems();
  showToast(`"${p.name}" sepete eklendi`);
  const btn = document.getElementById(`btn-${id}`);
  if (btn) { btn.textContent = '✓ Eklendi'; btn.classList.add('added'); }
}

function updateCartCount() {
  const total = Object.values(cart).reduce((s, i) => s + i.qty, 0);
  const el = document.getElementById('cartCount');
  el.textContent = total;
  el.classList.toggle('visible', total > 0);
}

function renderCartItems() {
  const container = document.getElementById('cartItems');
  const footer = document.getElementById('cartFooter');
  const items = Object.values(cart).filter(i => i.qty > 0);
  if (!items.length) {
    container.innerHTML = `<div class="cart-empty"><div class="cart-empty-icon">🛍</div><p>Sepetiniz boş</p></div>`;
    footer.style.display = 'none';
    return;
  }
  footer.style.display = 'block';
  container.innerHTML = items.map(item => `
    <div class="cart-item">
      <div class="cart-item-img">${item.emoji}</div>
      <div class="cart-item-info">
        <p class="cart-item-brand">${item.brand}</p>
        <p class="cart-item-name">${item.name}</p>
        <div class="cart-item-actions">
          <div class="qty-control">
            <button class="qty-btn" onclick="changeQty(${item.id}, -1)">−</button>
            <span class="qty-value">${item.qty}</span>
            <button class="qty-btn" onclick="changeQty(${item.id}, 1)">+</button>
          </div>
          <span class="cart-item-price">₺${(item.price * item.qty).toLocaleString('tr-TR')}</span>
        </div>
        <button class="remove-item" onclick="removeItem(${item.id})">Kaldır</button>
      </div>
    </div>
  `).join('');
  const total = items.reduce((s,i) => s + i.price * i.qty, 0);
  document.getElementById('cartTotal').textContent = `₺${total.toLocaleString('tr-TR')}`;
}

function changeQty(id, delta) {
  if (!cart[id]) return;
  cart[id].qty = Math.max(0, cart[id].qty + delta);
  if (cart[id].qty === 0) {
    delete cart[id];
    const btn = document.getElementById(`btn-${id}`);
    if (btn) { btn.textContent = '+ Ekle'; btn.classList.remove('added'); }
  }
  updateCartCount();
  renderCartItems();
}

function removeItem(id) {
  delete cart[id];
  const btn = document.getElementById(`btn-${id}`);
  if (btn) { btn.textContent = '+ Ekle'; btn.classList.remove('added'); }
  updateCartCount();
  renderCartItems();
}

function openCart() {
  document.getElementById('cartDrawer').classList.add('open');
  document.getElementById('overlay').classList.add('open');
  document.body.style.overflow = 'hidden';
  renderCartItems();
}

function closeCart() {
  document.getElementById('cartDrawer').classList.remove('open');
  document.getElementById('overlay').classList.remove('open');
  document.body.style.overflow = '';
}

// ── WISHLIST ──
function toggleLike(e, id) {
  e.stopPropagation();
  liked[id] = !liked[id];
  renderProducts(activeFilter);
  if (liked[id]) showToast('Favorilere eklendi ♡');
}

// ── SEARCH ──
function toggleSearch() {
  const bar = document.getElementById('searchBar');
  bar.classList.toggle('open');
  if (bar.classList.contains('open')) document.getElementById('searchInput').focus();
}

// ── TOAST ──
let toastTimer;
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2500);
}

// ── SCROLL ──
function scrollToProducts(e) {
  e.preventDefault();
  document.getElementById('products').scrollIntoView({ behavior: 'smooth' });
}

// ── KEYBOARD ──
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    closeCart();
    document.getElementById('searchBar').classList.remove('open');
  }
});

// ── INIT ──
renderProducts('all');
</script>
</body>
</html>
